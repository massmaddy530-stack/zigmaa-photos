# Copy to ingestion-agent/.env (gitignored). NEVER commit real values.

# --- Backend (existing agent API) ---
API_BASE_URL=http://localhost:8000
# The backend's upload-only INGEST_API_KEY (from backend/.env). Do not use the admin key here.
INGEST_API_KEY=change-me-ingest-key
# The event every capture is uploaded to (UUID from the dashboard URL /dashboard/events/<id>).
EVENT_ID=00000000-0000-0000-0000-000000000000

# --- Camera ---
# folder = upload photos that camera software saves into WATCH_FOLDER (Sony/Canon/Nikon/any camera; recommended)
# rtsp   = grab stills from an IP camera's RTSP video stream (only cameras that really offer RTSP)
# mock   = synthetic test images labelled "MOCK CAPTURE" (no camera needed)
CAMERA_SOURCE=mock
# Short name used in spool filenames (letters, digits, - and _).
CAMERA_NAME=cam1

# --- Folder mode (CAMERA_SOURCE=folder) ---
# The folder your camera's transfer software (or card import) saves JPEGs into. Originals are only read, never
# moved, changed or deleted. It may be missing at start (card/share not connected yet): the agent waits for it.
# WATCH_FOLDER=C:\EventPhotos
# Also scan subfolders (e.g. software that creates one folder per day/card).
# FOLDER_RECURSIVE=false
# Seconds between folder scans.
# FOLDER_POLL_INTERVAL_S=2
# A file is uploaded only after its size and timestamp have not changed for this many seconds
# (raise to 5-10 for slow Wi-Fi transfers or network shares).
# FILE_STABLE_SECONDS=3
# Also upload .png files (JPEG/.jpg/.jpeg are always included; RAW files such as .ARW/.CR3/.NEF are never uploaded).
# FOLDER_INCLUDE_PNG=true
# false (default): photos already in WATCH_FOLDER the first time the agent runs for this EVENT_ID are skipped, so an
# old event's photos never leak into a new event. true: upload them too.
# FOLDER_INCLUDE_EXISTING=false
# Optional for mock: cycle through your own sample photos instead of generated scenes.
# MOCK_IMAGE_DIR=C:\Users\you\Pictures\event-samples
# MOCK_SCENE_SECONDS=10
# Simulate a dropout every N frame reads (tests reconnects). 0 = never.
# MOCK_DROP_EVERY_N_READS=0

# RTSP: the stream path differs per camera model - copy it from the camera's manual/app.
# Must be a private LAN address. Prefer CAMERA_USERNAME/CAMERA_PASSWORD over credentials inside the URL.
# Many photo cameras (including the Sony a6400) do NOT provide RTSP: use folder mode for them.
# CAMERA_RTSP_URL=rtsp://192.168.1.50:554/your-camera-stream-path
# CAMERA_USERNAME=
# CAMERA_PASSWORD=
# CAMERA_RTSP_TRANSPORT=tcp
# CAMERA_OPEN_TIMEOUT_S=10
# CAMERA_STALE_AFTER_S=10

# --- Capture (mock and rtsp only) ---
# interval = one still every CAPTURE_INTERVAL_S | motion = a still when the scene changes (frame differencing)
CAPTURE_MODE=interval
CAPTURE_INTERVAL_S=10
# MOTION_THRESHOLD=0.02
# MOTION_COOLDOWN_S=5
# MOTION_CHECK_INTERVAL_S=0.5
JPEG_QUALITY=92

# --- Upload / reliability ---
# Keep a local copy after the server confirms it (spool/<event>/uploaded). Set false for long events to save disk.
KEEP_UPLOADED=true
UPLOAD_BATCH_SIZE=10
# Seconds between upload attempts when idle.
# UPLOAD_INTERVAL_S=2
# Backoff range for camera/folder reconnects and failed uploads.
# RECONNECT_MIN_S=1
# RECONNECT_MAX_S=60
# REQUEST_TIMEOUT_S=60
# Must match the backend's MAX_UPLOAD_BYTES; larger files are skipped and logged.
# MAX_UPLOAD_BYTES=41943040
# Where pending/uploaded copies, status.json and the folder ledger live (default: ingestion-agent\spool).
# Must not be inside WATCH_FOLDER.
# SPOOL_DIR=
