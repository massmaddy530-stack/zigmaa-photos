# Copy to backend/.env for native development (or to .env at the repo root for docker compose).
# NEVER commit real values. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
# PUBLIC_BASE_URL: the backend's public address (signed image links). FRONTEND_BASE_URL: the guest page address
# encoded in event QR codes. localhost / LAN addresses only work on this computer or network; guests' phones need
# public HTTPS, e.g. https://api.example.com and https://photos.example.com (see GUEST_ACCESS.md).
PUBLIC_BASE_URL=http://192.168.1.11:8000
FRONTEND_BASE_URL=http://192.168.1.11:3000
CORS_ORIGINS=http://localhost:3000,http://192.168.1.11:3000

# --- Auth (required) ---
ADMIN_API_KEY=change-me-admin-key-at-least-24-chars
INGEST_API_KEY=change-me-ingest-key-at-least-24-chars
SIGNING_SECRET=change-me-signing-secret-at-least-32-characters

# --- PostgreSQL (+ pgvector) ---
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=DATABASE_URL=postgresql+asyncpg://postgres.gfqkbgmuaafazbbuhwdl:MADHAVAN@290902@
aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: enables integration tests. The DB name must contain "test"; its schema is dropped/re-created.
# TEST_DATABASE_URL=postgresql+asyncpg://eventphoto:YOUR_PASSWORD@localhost:5432/eventphoto_test

# --- Redis / background tasks ---
REDIS_URL=redis://localhost:6379/0
# celery = Redis + Celery worker (production) | thread = in-process background thread (dev without Redis)
TASK_MODE=thread
TASK_MAX_RETRIES=3
# TEST_REDIS_URL=redis://localhost:6379/15

# --- Storage ---
# local = files under backend/data/storage served via signed /media URLs | r2 = Cloudflare R2
# | supabase = Supabase Storage (S3 API). Hosts without a persistent disk (e.g. Render free) lose local files on
# every restart: use r2 or supabase there. Copy existing files first: python -m scripts.migrate_storage --help
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=backend/data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Supabase: Project Settings > Storage > S3 connection. Use a PRIVATE bucket; the S3 keys bypass RLS (server only).
SUPABASE_PROJECT_REF=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=
# SUPABASE_S3_ENDPOINT=   # optional; defaults to https://<project_ref>.storage.supabase.co/storage/v1/s3
SIGNED_URL_TTL_S=900

# --- Limits ---
MAX_UPLOAD_BYTES=41943040
MAX_FILES_PER_REQUEST=50
SELFIE_MAX_BYTES=8388608

# --- Face analysis (values are starting points, NOT calibrated; measure on your own data) ---
FACE_DET_THRESHOLD=0.5
FACE_MIN_SIZE_PX=24
MATCH_SIMILARITY_THRESHOLD=0.40
MATCH_MAX_RESULTS=500
ONNX_INTRA_OP_THREADS=2
SELFIE_REQUIRE_SINGLE_FACE=true

# --- Rate limiting (memory = single process; redis = shared across API instances) ---
RATE_LIMIT_BACKEND=memory
MATCH_RATE_LIMIT=10
MATCH_RATE_WINDOW_S=60
TRUST_PROXY_HEADERS=false

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
