PORT=10000
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
ALLOWED_ORIGINS=https://zigmaa-photos.vercel.app,http://localhost:3000
CORS_ORIGINS=https://zigmaa-photos.vercel.app,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=https://zigmaa-photos.vercel.app

# --- Auth ---
ADMIN_API_KEY=change-me-admin-key-at-least-24-chars
INGEST_API_KEY=change-me-ingest-key-at-least-24-chars
SIGNING_SECRET=change-me-signing-secret-at-least-32-characters

# --- PostgreSQL (+ pgvector) ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Redis / background tasks ---
REDIS_URL=redis://localhost:6379/0
TASK_MODE=thread
TASK_MAX_RETRIES=3

# --- Cloudflare R2 Storage ---
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zigmaa-photos
R2_BUCKET=zigmaa-photos
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# --- Limits ---
MAX_UPLOAD_BYTES=41943040
MAX_FILES_PER_REQUEST=50
SELFIE_MAX_BYTES=8388608

# --- Face analysis (buffalo_sc lightweight model) ---
FACE_MODEL_NAME=buffalo_sc
FACE_DET_SIZE=320
FACE_ANALYSIS_MAX_SIDE=1024
FACE_DET_THRESHOLD=0.5
FACE_MIN_SIZE_PX=24
MATCH_SIMILARITY_THRESHOLD=0.40
MATCH_MAX_RESULTS=500
ONNX_INTRA_OP_THREADS=2
SELFIE_REQUIRE_SINGLE_FACE=true

# --- Rate limiting ---
RATE_LIMIT_BACKEND=memory
MATCH_RATE_LIMIT=10
MATCH_RATE_WINDOW_S=60
TRUST_PROXY_HEADERS=false
