# Copy to frontend/.env.local. NEXT_PUBLIC_* values are visible to browsers; everything else stays on the server.

# Backend URL used by the browser for guest (public) endpoints and media. Must be reachable by guests' phones.
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.11:8000

# Backend URL used by the Next.js server (admin proxy). Defaults to NEXT_PUBLIC_API_BASE_URL.
# In Docker this is typically the internal service name, e.g. http://backend:8000
API_BASE_URL=http://localhost:8000

# Client-side pre-check; keep in sync with backend MAX_UPLOAD_BYTES.
NEXT_PUBLIC_MAX_UPLOAD_MB=40

# Set to "false" only if you serve the production build over plain HTTP on a LAN (not recommended).
# COOKIE_SECURE=true

# --- Admin sign-in (server-side secrets; never prefix these with NEXT_PUBLIC_) ---------------------------------
# Sign-in is disabled (fails closed) until all four are set.
ADMIN_USERNAME=
# Generate with: node scripts/hash-password.mjs   (paste the printed scrypt$... value; never the password itself)
ADMIN_PASSWORD_HASH=
# At least 32 random characters, different from ADMIN_API_KEY, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every admin out.
SESSION_SECRET=
# Exactly the same value as the backend's ADMIN_API_KEY. Used only by the server-side admin proxy.
ADMIN_API_KEY=
